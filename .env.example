# Postgres connection string (Neon, Render Postgres, or any Postgres)
# Neon: Dashboard -> Connection Details -> Prisma (keep ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Any long random string — signs the session cookie
SESSION_SECRET="change-me-to-a-long-random-string"

# Google sign-in (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
# Authorized redirect URI must be: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL of the app (used to build the Google redirect URI)
# e.g. https://shivtei-yisroel-crm.onrender.com — for local dev: http://localhost:3000
APP_URL="http://localhost:3000"
