# Names only; set real values on the controller, never in git.
# Mixer model: x32 (Behringer X32 / Midas M32) or xair (XR12/16/18, MR18)
ZONEMIX_MIXER_TYPE=
# Mixer IP address on the show network, e.g. a fixed DHCP lease
ZONEMIX_MIXER_HOST=
# UDP port the controller listens on for sensor packets (default 7700)
ZONEMIX_SENSOR_PORT=
# Venue file to load (default config/example-venue.json)
ZONEMIX_VENUE_FILE=
